; Sandbox policy for the isolated XR Device Service on macOS.
; The contents of common.sb are implicitly included.

; When XR_RUNTIME_JSON selects a development runtime, the browser process
; canonicalizes the manifest's parent directory and passes it as this optional
; sandbox parameter. Allowing the selected build tree lets the OpenXR loader
; read the manifest and dlopen its runtime without opening unrelated user files.
(define openxr-runtime-dir "OPENXR_RUNTIME_DIR")
(if (param-defined? openxr-runtime-dir)
  (allow file-read* file-map-executable
    (subpath (param openxr-runtime-dir))))

; System-wide OpenXR runtime discovery on macOS follows the Khronos loader's
; Unix-style active runtime manifest. Permit only that registry directory so a
; sandboxed XR service can honor the system-selected runtime without requiring
; XR_RUNTIME_JSON.
(allow file-read*
  (subpath "/usr/local/share/openxr/1"))

; Meta XR Simulator installs its native runtime inside this application bundle.
; The OpenXR loader must be able to read the manifest and map the simulator
; runtime dylib plus its bundled support libraries/resources. Keep the exception
; scoped to the simulator bundle rather than opening /Applications generally.
(allow file-read* file-map-executable
  (subpath "/Applications/MetaXRSimulator.app"))

; The simulator stores configuration, key bindings and logs under its own
; Application Support directory. It also starts a localhost RPC service used by
; the simulator UI; the GPU policy composed with this profile supplies the
; required local socket primitives.
(define meta-xr-simulator-data-dir
  (user-homedir-path "/Library/Application Support/MetaXR"))
(allow file-read* file-write* file-write-create
  (subpath meta-xr-simulator-data-dir))

; Monado's native OpenXR client still uses its ordinary Unix-domain IPC
; channel to monado-service. On macOS, without XDG overrides, the socket lives
; below ~/Library/Caches/monado. Permit only that runtime directory and socket.
(define monado-runtime-dir
  (user-homedir-path "/Library/Caches/monado"))
(allow file-read* file-write-create
  (subpath monado-runtime-dir))
(allow network-outbound
  (literal (string-append monado-runtime-dir "/monado_comp_ipc")))

; Monado's macOS OpenXR runtime is linked against the Homebrew Vulkan loader
; even when Chromium uses the native Metal graphics binding. Homebrew's
; /opt/homebrew/opt/vulkan-loader path is a symlink into Cellar. Seatbelt may
; evaluate the resolved vnode path, while dyld reports the original opt path,
; so permit this formula directory in both locations without opening the rest
; of Homebrew.
(allow file-read* file-map-executable
  (subpath "/opt/homebrew/opt/vulkan-loader")
  (subpath "/opt/homebrew/Cellar/vulkan-loader"))

; Chromium's OpenXR process loads only the small Monado helper used to turn
; shared Metal textures into opaque XPC tokens.
(allow file-read* file-map-executable
  (literal "/usr/local/lib/libmonado_metal_xpc_client.dylib"))

; XPC itself remains implemented by the Monado helper rather than Chromium.
(allow mach-lookup
  (global-name "org.freedesktop.monado.metal-ipc"))
