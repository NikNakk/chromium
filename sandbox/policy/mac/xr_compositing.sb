; Sandbox policy for the isolated XR Device Service on macOS.
; The contents of common.sb are implicitly included.

; When XR_RUNTIME_JSON selects a development runtime, the browser process
; canonicalizes the manifest's parent directory and passes it as this optional
; sandbox parameter. Allowing the selected build tree lets the OpenXR loader
; read the manifest and dlopen its runtime without opening unrelated user files.
(define openxr-runtime-dir "OPENXR_RUNTIME_DIR")
(if (param-defined? openxr-runtime-dir)
  (allow file-read* file-map-executable
    (subpath (param openxr-runtime-dir))))

; Monado's native OpenXR client still uses its ordinary Unix-domain IPC
; channel to monado-service. On macOS, without XDG overrides, the socket lives
; below ~/Library/Caches/monado. Permit only that runtime directory and socket.
(define monado-runtime-dir
  (user-homedir-path "/Library/Caches/monado"))
(allow file-read* file-write-create
  (subpath monado-runtime-dir))
(allow network-outbound
  (literal (string-append monado-runtime-dir "/monado_comp_ipc")))

; Monado's macOS OpenXR runtime is linked against the Homebrew Vulkan loader
; even when Chromium uses the native Metal graphics binding. dyld must be able
; to map that dependency before the runtime can initialize. Keep this grant to
; the versioned loader dylib rather than opening the Homebrew prefix generally.
(allow file-read* file-map-executable
  (literal "/opt/homebrew/opt/vulkan-loader/lib/libvulkan.1.dylib"))

; Chromium's OpenXR process loads only the small Monado helper used to turn
; shared Metal textures into opaque XPC tokens.
(allow file-read* file-map-executable
  (literal "/usr/local/lib/libmonado_metal_xpc_client.dylib"))

; XPC itself remains implemented by the Monado helper rather than Chromium.
(allow mach-lookup
  (global-name "org.freedesktop.monado.metal-ipc"))
